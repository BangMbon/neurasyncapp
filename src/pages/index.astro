            <div class="footer-links">
              <div>
                <h4>Product</h4>
                <a href="#product">Affiliate Video Studio</a>
                <a href="#workflow">Workflow</a>
                <a href="#technology">Technology</a>
              </div>

              <div>
                <h4>Company</h4>
                <a href="#company">About</a>
                <a href="mailto:hello@neurasyncapp.com">
                  Contact
                </a>
              </div>

              <div>
                <h4>Legal</h4>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
              </div>
            </div>
          </div>

          <div class="footer-bottom">
            <span>© {year} NeuraSyncApp.</span>

            <span>
              Built in Indonesia.
            </span>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const links = document.querySelectorAll('a[href^="#"]');

      links.forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");

          if (!href || href === "#") return;

          const target = document.querySelector(href);

          if (target) {
            event.preventDefault();

            target.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #07080a;
    --bg-soft: #0b0d10;
    --surface: rgba(255, 255, 255, 0.035);
    --surface-strong: rgba(255, 255, 255, 0.055);
    --border: rgba(255, 255, 255, 0.09);
    --border-strong: rgba(255, 255, 255, 0.14);
    --text: #f5f7f5;
    --muted: #979d99;
    --muted-light: #b8bdb9;
    --accent: #b9ff66;
    --accent-soft: rgba(185, 255, 102, 0.1);
    --accent-border: rgba(185, 255, 102, 0.22);
    --container: 1240px;
    --radius: 24px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    min-width: 320px;
    background:
      radial-gradient(
        circle at 50% -20%,
        rgba(185, 255, 102, 0.05),
        transparent 35%
      ),
      var(--bg);
    color: var(--text);
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
    font: inherit;
  }

  .page-shell {
    position: relative;
    overflow: hidden;
  }

  .container {
    width: min(calc(100% - 48px), var(--container));
    margin: 0 auto;
  }

  .ambient {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(100px);
    opacity: 0.12;
  }

  .ambient-one {
    width: 600px;
    height: 600px;
    background: #87ff47;
    top: 300px;
    right: -450px;
  }

  .ambient-two {
    width: 500px;
    height: 500px;
    background: #5885ff;
    top: 1300px;
    left: -420px;
    opacity: 0.05;
  }

  /* HEADER */

  .site-header {
    position: relative;
    z-index: 50;
    height: 86px;
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border: 1px solid rgba(185, 255, 102, 0.4);
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: rgba(185, 255, 102, 0.08);
  }

  .brand-mark > span {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
    transform: rotate(45deg);
    box-shadow: 0 0 20px rgba(185, 255, 102, 0.6);
  }

  .brand-text {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .brand-text strong {
    color: var(--accent);
    font-weight: 600;
  }

  .desktop-nav {
    display: flex;
    gap: 34px;
  }

  .desktop-nav a {
    color: var(--muted);
    font-size: 14px;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .desktop-nav a:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  .nav-cta {
    height: 39px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    background: rgba(255, 255, 255, 0.025);
    transition: 180ms ease;
  }

  .nav-cta:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-cta svg {
    width: 16px;
  }

  /* HERO */

  .hero {
    padding: 108px 0 125px;
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.87fr) minmax(560px, 1.13fr);
    gap: 74px;
    align-items: center;
  }

  .eyebrow {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted-light);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 28px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 999px;
    box-shadow: 0 0 16px rgba(185, 255, 102, 0.7);
  }

  .hero h1 {
    max-width: 660px;
    font-size: clamp(56px, 6vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  .hero h1 span {
    display: block;
    color: #757a77;
  }

  .hero-description {
    max-width: 620px;
    color: var(--muted-light);
    font-size: 18px;
    line-height: 1.75;
    margin-top: 31px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 35px;
  }

  .button {
    height: 48px;
    padding: 0 19px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      background 170ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button svg {
    width: 17px;
  }

  .button-primary {
    background: var(--accent);
    color: #10140c;
    border: 1px solid var(--accent);
  }

  .button-primary:hover {
    background: #c7ff82;
  }

  .button-secondary {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border);
  }

  .button-secondary:hover {
    border-color: var(--border-strong);
  }

  .hero-meta {
    display: flex;
    gap: 36px;
    margin-top: 61px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .hero-meta > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .meta-label {
    font-family: "DM Mono", monospace;
    font-size: 9px;
    color: #696e6b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-meta strong {
    color: #cdd1ce;
    font-size: 12px;
    font-weight: 500;
  }

  /* PRODUCT UI MOCKUP */

  .hero-visual {
    position: relative;
  }

  .visual-glow {
    position: absolute;
    inset: 10% 10%;
    background: var(--accent);
    opacity: 0.075;
    filter: blur(100px);
    border-radius: 50%;
  }

  .app-window {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #0a0c0e;
    box-shadow:
      0 35px 100px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.015) inset;
    transform: perspective(1500px) rotateY(-2deg) rotateX(1deg);
  }

  .app-topbar {
    height: 43px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.075);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    background: #0d0f11;
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .window-controls span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2a2d30;
  }

  .app-title {
    color: #858b87;
    font-size: 9px;
    font-family: "DM Mono", monospace;
    letter-spacing: 0.03em;
  }

  .app-state {
    justify-self: end;
    color: #68706a;
    font-size: 8px;
    font-family: "DM Mono", monospace;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .app-state span {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }

  .app-body {
    height: 455px;
    display: flex;
  }

  .app-sidebar {
    width: 49px;
    padding: 14px 8px;
    border-right: 1px solid rgba(255, 255, 255, 0.065);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    background: #0b0d0f;
  }

  .sidebar-logo {
    height: 32px;
    display: grid;
    place-items: center;
    margin-bottom: 4px;
  }

  .sidebar-logo span {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .sidebar-item {
    width: 31px;
    height: 31px;
    border-radius: 7px;
    border: 0;
    background: transparent;
    color: #5a5f5c;
    display: grid;
    place-items: center;
  }

  .sidebar-item svg {
    width: 14px;
  }

  .sidebar-item.active {
    color: var(--accent);
    background: rgba(185, 255, 102, 0.08);
  }

  .editor {
    flex: 1;
    min-width: 0;
  }

  .editor-header {
    height: 61px;
    padding: 0 17px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .editor-label {
    font-family: "DM Mono", monospace;
    font-size: 7px;
    color: #555b57;
    letter-spacing: 0.08em;
  }

  .editor-header h3 {
    margin-top: 3px;
    font-size: 12px;
    font-weight: 500;
  }

  .editor-actions {
    display: flex;
    gap: 6px;
  }

  .editor-actions button {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    background: #111417;
    color: #858a87;
    padding: 6px 9px;
    font-size: 8px;
  }

  .editor-actions .generate-button {
    background: var(--accent);
    color: #10140c;
    border-color: var(--accent);
  }

  .editor-grid {
    height: calc(100% - 61px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 155px;
  }

  .preview-panel {
    padding: 14px;
    min-width: 0;
  }

  .preview-video {
    height: 234px;
    width: 132px;
    margin: 0 auto;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 36%,
        rgba(185, 255, 102, 0.16),
        transparent 30%
      ),
      linear-gradient(150deg, #131719, #0d1012);
  }

  .video-badge {
    position: absolute;
    left: 7px;
    top: 7px;
    font-family: "DM Mono", monospace;
    font-size: 5px;
    color: #8e9490;
    letter-spacing: 0.07em;
  }

  .product-placeholder {
    position: absolute;
    inset: 22% 0 29%;
    display: grid;
    place-items: center;
  }

  .product-glow {
    position: absolute;
    width: 85px;
    height: 85px;
    border-radius: 50%;
    background: rgba(185, 255, 102, 0.09);
    filter: blur(20px);
  }

  .product-card {
    width: 43px;
    height: 83px;
    position: relative;
  }

  .product-cap {
    display: block;
    width: 24px;
    height: 12px;
    background: linear-gradient(#cfd3cf, #8d938e);
    margin: 0 auto -1px;
    border-radius: 4px 4px 2px 2px;
  }

  .product-body {
    display: block;
    width: 43px;
    height: 70px;
    border-radius: 9px 9px 13px 13px;
    background:
      linear-gradient(
        130deg,
        rgba(255, 255, 255, 0.22),
        transparent 40%
      ),
      linear-gradient(#a9d6a5, #4a7250);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .caption-preview {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 38px;
    text-align: center;
    font-size: 8px;
    line-height: 1.3;
  }

  .caption-preview strong {
    display: block;
    color: var(--accent);
  }

  .video-bottom {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 7px;
    display: flex;
    justify-content: space-between;
    color: #6d736e;
    font-size: 5px;
    font-family: "DM Mono", monospace;
  }

  .timeline {
    margin-top: 17px;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    color: #777d79;
    font-size: 7px;
    margin-bottom: 7px;
  }

  .timeline-track {
    position: relative;
    display: flex;
    gap: 3px;
    height: 39px;
  }

  .scene {
    flex: 1;
    border: 1px solid rgba(255, 255, 255, 0.075);
    background: #111417;
    border-radius: 4px;
    padding: 4px;
  }

  .scene span {
    color: #626763;
    font-family: "DM Mono", monospace;
    font-size: 5px;
  }

  .scene.active {
    border-color: rgba(185, 255, 102, 0.35);
    background: rgba(185, 255, 102, 0.06);
  }

  .scene.active span {
    color: var(--accent);
  }

  .playhead {
    position: absolute;
    left: 66%;
    top: -4px;
    bottom: -4px;
    width: 1px;
    background: var(--accent);
  }

  .audio-track {
    height: 38px;
    margin-top: 5px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 4px 7px;
    border-radius: 4px;
    background: rgba(185, 255, 102, 0.035);
    border: 1px solid rgba(185, 255, 102, 0.09);
    overflow: hidden;
  }

  .audio-label {
    flex: 0 0 auto;
    color: #768071;
    font-size: 5px;
    font-family: "DM Mono", monospace;
  }

  .waveform {
    height: 30px;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: 0.6;
  }

  .waveform i {
    display: block;
    width: 1px;
    max-height: 24px;
    background: var(--accent);
    border-radius: 2px;
  }

  .inspector {
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    padding: 14px 12px;
    background: #0c0f11;
  }

  .inspector-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #8d928f;
    font-size: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .green-dot {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }

  .control-block {
    margin-top: 14px;
  }

  .control-block label {
    display: block;
    margin-bottom: 6px;
    font-size: 6px;
    color: #646a66;
    font-family: "DM Mono", monospace;
    text-transform: uppercase;
  }

  .control-input,
  .select-control {
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 5px;
    background: #111416;
    padding: 8px;
    color: #9ca19d;
    font-size: 7px;
    line-height: 1.45;
  }

  .select-control {
    display: flex;
    justify-content: space-between;
  }

  .mode-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .mode-grid button {
    padding: 7px 3px;
    background: #111416;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    color: #656a67;
    font-size: 6px;
  }

  .mode-grid button.selected {
    color: var(--accent);
    border-color: rgba(185, 255, 102, 0.18);
    background: rgba(185, 255, 102, 0.055);
  }

  .generation-status {
    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 6px;
    overflow: hidden;
  }

  .generation-status > div {
    display: flex;
    justify-content: space-between;
    padding: 7px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 6px;
  }

  .generation-status > div:last-child {
    border-bottom: 0;
  }

  .generation-status span {
    color: #686e6a;
  }

  .generation-status strong {
    color: #93c766;
    font-weight: 500;
  }

  .regenerate {
    margin-top: 15px;
    width: 100%;
    height: 28px;
    border-radius: 5px;
    border: 1px solid rgba(185, 255, 102, 0.16);
    color: var(--accent);
    background: rgba(185, 255, 102, 0.06);
    font-size: 7px;
    display: flex;
    gap: 5px;
    align-items: center;
    justify-content: center;
  }

  .regenerate svg {
    width: 10px;
  }

  .floating-card {
    position: absolute;
    z-index: 4;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 11px;
    padding: 10px 13px;
    background: rgba(14, 16, 18, 0.9);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  .floating-card span:first-child {
    flex: 0 0 auto;
  }

  .floating-card div {
    display: flex;
    flex-direction: column;
  }

  .floating-card div span {
    color: #696f6b;
    font-size: 6px;
    font-family: "DM Mono", monospace;
    text-transform: uppercase;
  }

  .floating-card strong {
    margin-top: 2px;
    font-size: 8px;
    font-weight: 500;
  }

  .floating-card-one {
    left: -24px;
    bottom: 67px;
  }

  .floating-card-two {
    right: -18px;
    top: 87px;
  }

  .floating-icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: rgba(185, 255, 102, 0.1);
    color: var(--accent);
    display: grid;
    place-items: center;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(185, 255, 102, 0.06);
  }

  /* POSITION STRIP */

  .position-strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 31px 0;
  }

  .position-strip .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .position-strip p {
    max-width: 430px;
    color: #838985;
    font-size: 13px;
  }

  .position-strip strong {
    color: #c0c5c1;
    font-weight: 500;
  }

  .position-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .position-tags span {
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: #6d736f;
    font-family: "DM Mono", monospace;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* SECTIONS */

  .section {
    padding: 150px 0;
  }

  .section-kicker {
    display: inline-block;
    color: var(--accent);
    font-size: 10px;
    font-family: "DM Mono", monospace;
    letter-spacing: 0.09em;
    margin-bottom: 20px;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: 100px;
    align-items: end;
    margin-bottom: 72px;
  }

  .section-heading h2,
  .philosophy-copy h2,
  .technology-copy h2,
  .company-content h2,
  .cta-content h2 {
    font-size: clamp(42px, 4.4vw, 67px);
    line-height: 1.04;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  .section-heading h2 span,
  .philosophy-copy h2 span,
  .technology-copy h2 span,
  .company-content h2 span,
  .cta-content h2 span {
    display: block;
    color: #747a76;
  }

  .section-heading > p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
    padding-bottom: 5px;
  }

  /* FEATURES */

  .product-section {
    border-bottom: 1px solid var(--border);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .feature-card {
    min-height: 275px;
    padding: 30px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background 180ms ease;
  }

  .feature-card:hover {
    background: rgba(255, 255, 255, 0.018);
  }

  .feature-top {
    display: flex;
    justify-content: space-between;
  }

  .feature-top > span {
    color: #575d59;
    font-family: "DM Mono", monospace;
    font-size: 9px;
  }

  .feature-icon {
    width: 31px;
    height: 31px;
    border: 1px solid rgba(185, 255, 102, 0.16);
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: rgba(185, 255, 102, 0.035);
  }

  .feature-icon span {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 2px;
    transform: rotate(45deg);
  }

  .feature-card h3 {
    margin-top: 79px;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .feature-card p {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
  }

  /* PHILOSOPHY */

  .philosophy-section {
    background: #090b0d;
    border-bottom: 1px solid var(--border);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 130px;
  }

  .philosophy-copy {
    position: sticky;
    top: 100px;
    align-self: start;
