                        <path
                          d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                        />
                        <path
                          d="m7 16 3.2-3.5 2.3 2.4 2.2-2.5L18 16"
