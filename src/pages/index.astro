---
const year = new Date().getFullYear();

const features = [
  {
    number: "01",
    title: "Product-to-Video Workflow",
    description:
      "Turn product assets and structured inputs into an editable short-form video production workflow.",
  },
  {
    number: "02",
    title: "AI Creative Direction",
    description:
      "Generate hooks, scripts, scene structures, captions, and creative directions designed for commerce content.",
  },
  {
    number: "03",
    title: "Localized Voice & Captions",
    description:
      "Generate natural Indonesian voice-over, subtitles, and commerce-focused calls-to-action inside one workflow.",
  },
  {
    number: "04",
    title: "Selective Regeneration",
    description:
      "Regenerate individual scenes, scripts, or voice segments without rebuilding the entire project.",
  },
  {
    number: "05",
    title: "Persistent Projects",
    description:
      "Keep project state, generated assets, edits, and production history organized across long-running workflows.",
  },
  {
    number: "06",
    title: "Production-Ready Export",
    description:
      "Move from AI-assisted ideation to editable vertical content and publish-ready creative assets.",
  },
];

const workflow = [
  {
    step: "01",
    title: "Add product assets",
    description:
      "Start with product photos, details, positioning, and structured campaign inputs.",
  },
  {
    step: "02",
    title: "Generate direction",
    description:
      "NeuraSyncApp creates hooks, scripts, scene plans, captions, and a structured creative concept.",
  },
  {
    step: "03",
    title: "Build the first cut",
    description:
      "Generate voice-over, subtitles, scene media, and the first editable vertical video draft.",
  },
  {
    step: "04",
    title: "Refine selectively",
    description:
      "Rewrite, regenerate, or replace only the parts that need improvement while preserving the rest.",
  },
];

const principles = [
  {
    title: "Automate repetition",
    description:
      "Use AI for repetitive production work while keeping the creator focused on direction and judgment.",
  },
  {
    title: "Preserve control",
    description:
      "Generated content stays editable. Individual components can be changed without destroying the full project.",
  },
  {
    title: "Build durable workflows",
    description:
      "Projects, media jobs, generation state, retries, and outputs are designed as persistent production workflows.",
  },
];

const technology = [
  "AI inference orchestration",
  "Asynchronous media processing",
  "Persistent project state",
  "Structured generation pipelines",
  "Human-in-the-loop editing",
  "Cloud-native infrastructure",
];

const nav = [
  { label: "Product", href: "#product" },
  { label: "Workflow", href: "#workflow" },
  { label: "Technology", href: "#technology" },
  { label: "Company", href: "#company" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>NeuraSyncApp — AI Creative Software for Modern Commerce</title>

    <meta
      name="description"
      content="NeuraSyncApp builds AI-native creative software for short-form commerce. Generate scripts, scenes, voice-over, subtitles, editable video drafts, and publish-ready vertical content."
    />

    <meta
      name="keywords"
      content="NeuraSyncApp, AI video, affiliate video, AI creative software, short form commerce, AI video editor, video automation"
    />

    <meta name="author" content="NeuraSyncApp" />
    <meta name="theme-color" content="#07080a" />

    <meta
      property="og:title"
      content="NeuraSyncApp — AI Creative Software"
    />
    <meta
      property="og:description"
      content="AI-native creative software for modern commerce."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://neurasyncapp.com" />

    <link rel="canonical" href="https://neurasyncapp.com" />

    <link rel="icon" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
