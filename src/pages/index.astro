                              <span>01</span>
                            </div>
                            <div class="scene scene-two">
                              <span>02</span>
                            </div>
                            <div class="scene scene-three active">
                              <span>03</span>
                            </div>
                            <div class="scene scene-four">
                              <span>04</span>
                            </div>

                            <div class="playhead"></div>
                          </div>

                          <div class="audio-track">
