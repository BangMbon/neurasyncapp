                          y="4"
                          width="16"
                          height="16"
                          rx="3"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                        />
                        <path
                          d="M9 9h6M9 13h6M9 17h3"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                      </svg>
                    </button>

                    <button class="sidebar-item" aria-label="Media">
