        <!-- PRODUCT -->
        <section class="section product-section" id="product">
          <div class="container">
            <div class="section-heading">
              <div>
                <span class="section-kicker">01 / PRODUCT</span>

                <h2>
                  One production system.
                  <span>From product input to editable output.</span>
                </h2>
              </div>

              <p>
                Affiliate Video Studio brings fragmented production
                tasks into a single AI-assisted workflow designed around
                persistent projects and selective editing.
              </p>
            </div>

            <div class="feature-grid">
              {
                features.map((feature) => (
                  <article class="feature-card">
                    <div class="feature-top">
                      <span>{feature.number}</span>

                      <div class="feature-icon">
                        <span></span>
                      </div>
                    </div>

                    <h3>{feature.title}</h3>

                    <p>{feature.description}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <!-- PHILOSOPHY -->
        <section class="section philosophy-section">
          <div class="container philosophy-grid">
            <div class="philosophy-copy">
              <span class="section-kicker">PRODUCT PHILOSOPHY</span>

              <h2>
                Automate repetition.
                <span>Preserve judgment.</span>
              </h2>

              <p>
                NeuraSyncApp is designed around the idea that AI should
                accelerate production without removing human creative
                control.
              </p>
            </div>

            <div class="principle-list">
              {
                principles.map((principle, index) => (
                  <article class="principle">
                    <div class="principle-number">
                      0{index + 1}
                    </div>

                    <div>
                      <h3>{principle.title}</h3>
                      <p>{principle.description}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <!-- WORKFLOW -->
        <section class="section workflow-section" id="workflow">
          <div class="container">
            <div class="section-heading workflow-heading">
              <div>
                <span class="section-kicker">02 / WORKFLOW</span>

                <h2>
                  From asset to first cut
                  <span>without losing control.</span>
                </h2>
              </div>

              <p>
                A structured production pipeline replaces repeated
                manual tasks while keeping every important output
                inspectable and editable.
              </p>
            </div>

            <div class="workflow">
              {
                workflow.map((item) => (
                  <article class="workflow-item">
                    <div class="workflow-step">
                      {item.step}
                    </div>

                    <div class="workflow-line">
                      <span></span>
                    </div>

                    <div class="workflow-content">
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <!-- TECHNOLOGY -->
        <section class="section technology-section" id="technology">
          <div class="container technology-grid">
            <div class="technology-copy">
              <span class="section-kicker">03 / TECHNOLOGY</span>

              <h2>
                Cloud-first infrastructure for
                <span>AI-native creative workflows.</span>
              </h2>

              <p>
                NeuraSyncApp combines model inference, structured AI
                generation, asynchronous processing, project
                persistence, and creator-facing editing in a unified
                software architecture.
              </p>

              <div class="technology-list">
                {
                  technology.map((item) => (
                    <div>
                      <span class="tech-check">
                        ✓
                      </span>

                      {item}
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="architecture-card">
              <div class="architecture-header">
                <span>NEURASYNC / PIPELINE</span>
                <span class="architecture-status">
                  ONLINE
                </span>
              </div>

              <div class="architecture-body">
                <div class="architecture-node input-node">
                  <span class="node-label">INPUT</span>
                  <strong>Product assets</strong>
                  <small>Images · Metadata · Direction</small>
                </div>

                <div class="connector vertical">
                  <span></span>
                </div>

                <div class="architecture-row">
                  <div class="architecture-node">
                    <span class="node-label">AI</span>
                    <strong>Creative engine</strong>
                    <small>Script · Hook · Scenes</small>
                  </div>

                  <div class="architecture-node">
                    <span class="node-label">MEDIA</span>
                    <strong>Processing</strong>
                    <small>Voice · Captions · Video</small>
                  </div>
                </div>

                <div class="connector vertical">
                  <span></span>
                </div>

                <div class="architecture-node output-node">
                  <span class="node-label">OUTPUT</span>
                  <strong>Editable project</strong>
                  <small>Persistent · Regeneratable · Exportable</small>
