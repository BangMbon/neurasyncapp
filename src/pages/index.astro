      rel="stylesheet"
    />
  </head>

  <body>
    <div class="page-shell">
      <div class="ambient ambient-one"></div>
      <div class="ambient ambient-two"></div>

      <!-- NAVBAR -->
      <header class="site-header">
        <div class="container nav-inner">
          <a href="/" class="brand" aria-label="NeuraSyncApp home">
            <span class="brand-mark">
              <span></span>
            </span>

            <span class="brand-text">
              NeuraSync
              <strong>App</strong>
            </span>
          </a>

          <nav class="desktop-nav" aria-label="Primary navigation">
            {
              nav.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))
            }
          </nav>

          <a class="nav-cta" href="mailto:hello@neurasyncapp.com">
            Contact
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M5 12h14M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </header>

      <main>
        <!-- HERO -->
        <section class="hero">
          <div class="container hero-grid">
            <div class="hero-copy">
              <div class="eyebrow">
                <span class="status-dot"></span>
                Building AI-native creative infrastructure
              </div>

              <h1>
                Creative software
                <span>built for modern commerce.</span>
              </h1>

              <p class="hero-description">
                NeuraSyncApp turns product assets into structured,
                editable short-form video workflows — combining AI
                creative direction, voice, subtitles, scene generation,
                and human-controlled editing.
              </p>

              <div class="hero-actions">
                <a class="button button-primary" href="#product">
                  Explore the product

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 12h14M13 6l6 6-6 6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>

                <a
                  class="button button-secondary"
                  href="mailto:hello@neurasyncapp.com"
                >
                  Contact us
                </a>
              </div>

              <div class="hero-meta">
                <div>
                  <span class="meta-label">Product</span>
                  <strong>Affiliate Video Studio</strong>
                </div>

                <div>
                  <span class="meta-label">Initial market</span>
                  <strong>Short-form commerce</strong>
                </div>

                <div>
                  <span class="meta-label">Based in</span>
                  <strong>Indonesia</strong>
                </div>
              </div>
            </div>

            <!-- PRODUCT UI -->
            <div class="hero-visual">
              <div class="visual-glow"></div>

              <div class="app-window">
                <div class="app-topbar">
                  <div class="window-controls">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>

                  <div class="app-title">
                    Affiliate Video Studio
                  </div>

                  <div class="app-state">
                    <span></span>
